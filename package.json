{
  "name": "chunklock-bedrock-addon",
  "version": "0.1.0",
  "productName": "Chunklock Bedrock Add-On",
  "description": "TypeScript starter for the Chunklock Minecraft Bedrock add-on",
  "private": true,
  "devDependencies": {
    "@minecraft/core-build-tasks": "^5.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint-plugin-minecraft-linting": "^2.0.10",
    "source-map": "^0.7.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "lint": "just-scripts lint",
    "build": "just-scripts build",
    "build:production": "just-scripts build --production",
    "clean": "just-scripts clean",
    "local-deploy": "just-scripts local-deploy",
    "mcaddon": "just-scripts mcaddon",
    "mcaddon:production": "just-scripts mcaddon --production",
    "dev": "just-scripts local-deploy --watch",
    "test": "node --test tests/*.test.cjs",
    "loot-tables:build": "python tools/build_loot_tables.py",
    "loot-tables:check": "python tools/build_loot_tables.py --check"
  },
  "dependencies": {
    "@minecraft/server": "2.6.0"
  },
  "overrides": {
    "vitest": "^4.1.12",
    "tinypool": "^2.2.0",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
